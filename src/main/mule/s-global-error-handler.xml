<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
      http://www.mulesoft.org/schema/mule/core
      http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/ee/core
      http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <error-handler name="employee-global-error-handler">

        <!-- EMPLOYEE NOT FOUND -->

        <on-error-propagate
            doc:name="Handle Employee Not Found Error"
            type="VALIDATION:INVALID_BOOLEAN"
            when='#[error.description == "Employee not found"]'>

            <set-variable
                doc:name="Set Employee Not Found HTTP Status 404"
                variableName="httpStatus"
                value="404"/>

            <ee:transform doc:name="Build Employee Not Found Error Response">
                <ee:message>
                    <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ERROR",
    errorCode: "EMP-404",
    message: error.description,
    correlationId: correlationId,
    timestamp: now() as String,
    apiName: "s-employee-api"
}
                    ]]></ee:set-payload>
                </ee:message>
            </ee:transform>

        </on-error-propagate>

        <!-- VALIDATION ERRORS -->

        <on-error-propagate
            doc:name="Handle Employee Validation Error"
            type="VALIDATION:*"
            logException="true">

            <ee:transform doc:name="Build Employee Validation Error Response">
                <ee:message>
                    <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ERROR",
    errorCode: "EMP-400",
    message: error.description,
    correlationId: correlationId,
    timestamp: (now() as String),
    apiName: p("app.name")
}
                    ]]></ee:set-payload>
                </ee:message>

                <ee:variables>
                    <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                </ee:variables>
            </ee:transform>

        </on-error-propagate>

        <!-- INVALID API REQUEST -->

        <on-error-propagate
            doc:name="Handle APIkit Bad Request Error"
            type="APIKIT:BAD_REQUEST">

            <ee:transform doc:name="Build Bad Request Error Response">
                <ee:message>
                    <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ERROR",
    errorCode: "EMP-400",
    message: error.description,
    correlationId: correlationId,
    timestamp: (now() as String),
    apiName: p("app.name")
}
                    ]]></ee:set-payload>
                </ee:message>

                <ee:variables>
                    <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                </ee:variables>
            </ee:transform>

        </on-error-propagate>

        <!-- UNKNOWN API RESOURCE -->

        <on-error-propagate
            doc:name="Handle APIkit Resource Not Found Error"
            type="APIKIT:NOT_FOUND">

            <ee:transform doc:name="Build Resource Not Found Error Response">
                <ee:message>
                    <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ERROR",
    errorCode: "EMP-404",
    message: "Resource not found",
    correlationId: correlationId,
    timestamp: (now() as String),
    apiName: p("app.name")
}
                    ]]></ee:set-payload>
                </ee:message>

                <ee:variables>
                    <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                </ee:variables>
            </ee:transform>

        </on-error-propagate>

        <!-- UNSUPPORTED HTTP METHOD -->

        <on-error-propagate
            doc:name="Handle APIkit Method Not Allowed Error"
            type="APIKIT:METHOD_NOT_ALLOWED">

            <ee:transform doc:name="Build Method Not Allowed Error Response">
                <ee:message>
                    <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ERROR",
    errorCode: "EMP-405",
    message: "Method not allowed",
    correlationId: correlationId,
    timestamp: (now() as String),
    apiName: p("app.name")
}
                    ]]></ee:set-payload>
                </ee:message>

                <ee:variables>
                    <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                </ee:variables>
            </ee:transform>

        </on-error-propagate>

        <!-- DATABASE CONNECTIVITY ERROR -->

        <on-error-propagate
            doc:name="Handle Database Connectivity Error"
            type="DB:CONNECTIVITY">

            <ee:transform doc:name="Build Database Unavailable Error Response">
                <ee:message>
                    <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ERROR",
    errorCode: "EMP-503",
    message: "Database unavailable",
    correlationId: correlationId,
    timestamp: (now() as String),
    apiName: p("app.name")
}
                    ]]></ee:set-payload>
                </ee:message>

                <ee:variables>
                    <ee:set-variable variableName="httpStatus">503</ee:set-variable>
                </ee:variables>
            </ee:transform>

        </on-error-propagate>

        <!-- DATABASE QUERY ERROR -->

        <on-error-propagate
            doc:name="Handle Database Query Execution Error"
            type="DB:QUERY_EXECUTION">

            <ee:transform doc:name="Build Database Query Error Response">
                <ee:message>
                    <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ERROR",
    errorCode: "EMP-500",
    message: "Database query execution failed",
    correlationId: correlationId,
    timestamp: (now() as String),
    apiName: p("app.name")
}
                    ]]></ee:set-payload>
                </ee:message>

                <ee:variables>
                    <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                </ee:variables>
            </ee:transform>

        </on-error-propagate>

        <!-- UNEXPECTED ERRORS -->

        <on-error-propagate
            doc:name="Handle Unexpected Employee API Error"
            type="ANY"
            logException="true">

            <ee:transform doc:name="Build Internal Server Error Response">
                <ee:message>
                    <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ERROR",
    errorCode: "EMP-500",
    message: "Internal Server Error",
    correlationId: correlationId,
    timestamp: (now() as String),
    apiName: p("app.name")
}
                    ]]></ee:set-payload>
                </ee:message>

                <ee:variables>
                    <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                </ee:variables>
            </ee:transform>

        </on-error-propagate>

    </error-handler>

</mule>