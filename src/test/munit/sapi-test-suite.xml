                is="#[MunitTools::equalTo('Employee deleted successfully')]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="test-get-all-employees-db">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Fetch All Employee Records"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
