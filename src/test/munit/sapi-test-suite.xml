    <!-- ============================================= -->
    <!-- DATABASE SUBFLOWS -->
    <!-- ============================================= -->

    <munit:test name="test-create-employee-db">
        <munit:behavior>
            <munit-tools:mock-when processor="db:insert">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Insert Employee Record"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{affectedRows: 1}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable
                variableName="createEmployeeRequestPayload"
                value="#[{employeeId: 'E1', name: 'Alice', address: 'Road', salary: 100}]"/>
            <flow-ref name="create-employee-in-db-flow"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.message]"
                is="#[MunitTools::equalTo('Employee created successfully')]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="test-update-employee-db">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Check Employee Exists Before Update"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[[{EMPLOYEE_ID: 'E1'}]]"/>
                    <munit-tools:variables>
                        <munit-tools:variable
                            key="employeeExists"
                            value="#[[{EMPLOYEE_ID: 'E1'}]]"/>
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit-tools:mock-when processor="db:update">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Update Employee Record"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{affectedRows: 1}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable
                variableName="employeeId"
                value="#['E1']"/>
            <set-variable
                variableName="updateEmployeeRequestPayload"
                value="#[{name: 'Alice', address: 'Road', salary: 100}]"/>
            <flow-ref name="update-employee-in-db-flow"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.message]"
                is="#[MunitTools::equalTo('Employee updated successfully')]"/>
        </munit:validation>
    </munit:test>

