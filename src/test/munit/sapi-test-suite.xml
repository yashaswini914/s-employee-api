        http://www.mulesoft.org/schema/mule/mule-apikit
        http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd">

    <munit:config name="employee-all-tests-config"/>

    <!-- ============================================= -->
    <!-- API ENTRY FLOWS -->
    <!-- ============================================= -->

    <munit:test name="test-employee-api-main">
        <munit:behavior>
            <munit-tools:mock-when processor="apikit:router">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Route Employee API Request"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{status: 'OK'}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="employee-api-main"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('OK')]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="test-employee-api-console">
        <munit:behavior>
            <munit-tools:mock-when processor="apikit:console">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Display Employee API Console"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{status: 'OK'}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="employee-api-console"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('OK')]"/>
        </munit:validation>
    </munit:test>

    <!-- ============================================= -->
    <!-- EMPLOYEE ROUTES -->
    <!-- ============================================= -->

    <munit:test name="test-create-employee-route">
        <munit:behavior>
            <munit-tools:mock-when processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Create Employee In Database"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{status: 'OK'}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload
                    value="#[{employeeId: 'E1', name: 'Alice', address: 'Road', salary: 100}]"/>
            </munit:set-event>
            <flow-ref name="post:\employees:application\json:employee-api-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.createEmployeeRequestPayload.employeeId]"
                is="#[MunitTools::equalTo('E1')]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="test-delete-employee-route">
        <munit:behavior>
            <munit-tools:mock-when processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Delete Employee From Database"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{status: 'OK'}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:attributes
                    value="#[{uriParams: {id: 'E1'}}]"/>
            </munit:set-event>
            <flow-ref name="delete:\employees\(id):employee-api-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.employeeId]"
                is="#[MunitTools::equalTo('E1')]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="test-get-all-employees-route">
        <munit:behavior>
            <munit-tools:mock-when processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Fetch All Employees From Database"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[[]]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="get:\employees:employee-api-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call
                processor="flow-ref"
                times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Fetch All Employees From Database"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

