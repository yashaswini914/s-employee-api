    <munit:test name="test-update-employee-route">
        <munit:behavior>
            <munit-tools:mock-when processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Update Employee In Database"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{status: 'OK'}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload
                    value="#[{name: 'Alice', address: 'Road', salary: 100}]"/>
                <munit:attributes
                    value="#[{uriParams: {id: 'E1'}}]"/>
            </munit:set-event>
            <flow-ref name="put:\employees\(id):application\json:employee-api-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.employeeId]"
                is="#[MunitTools::equalTo('E1')]"/>
            <munit-tools:assert-that
                expression="#[vars.updateEmployeeRequestPayload.name]"
                is="#[MunitTools::equalTo('Alice')]"/>
        </munit:validation>
    </munit:test>

    <!-- ============================================= -->
    <!-- CREATE EMPLOYEE VALIDATION -->
    <!-- ============================================= -->

    <munit:test name="test-valid-create-request">
        <munit:execution>
            <set-variable
                variableName="createEmployeeRequestPayload"
                value="#[{employeeId: 'E1', name: 'Alice', address: 'Road', salary: 100}]"/>
            <flow-ref name="validate-create-employee-request-flow"/>
        </munit:execution>
    </munit:test>

    <munit:test
        name="test-missing-employee-id"
        expectedErrorType="VALIDATION:INVALID_BOOLEAN">
        <munit:execution>
            <set-variable
                variableName="createEmployeeRequestPayload"
                value="#[{name: 'Alice', address: 'Road', salary: 100}]"/>
            <flow-ref name="validate-create-employee-request-flow"/>
        </munit:execution>
    </munit:test>

    <munit:test
